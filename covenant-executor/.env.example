# ── Required ────────────────────────────────────────────────────────────────
# Ethereum RPC (your own node, or a provider URL with your key)
AON_EVM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# A FRESH wallet used only for this. It pays gas for every settlement, so keep
# only a little ETH in it (e.g. 0.05). It never holds or touches trader funds.
AON_EXECUTOR_PRIVATE_KEY=0x...
# The deployed AonEvmSpotSettlement. The executor refuses to call anything else.
AON_EVM_SPOT_SETTLEMENT_CONTRACT=0x...

# ── Optional ────────────────────────────────────────────────────────────────
# AON nodes to read from, comma-separated; the first that answers is used,
# receipts are published to all of them.
AON_NODE_URLS=https://explorer.aon.network,https://node2.aon.network,https://node3.aon.network,https://node4.aon.network
# How often to look for new trades (ms)
POLL_INTERVAL_MS=3000
# Warn when the executor wallet's ETH balance drops below this
MIN_ETH_BALANCE=0.02
# Only settle fills whose executor fee (in quote units; USDC and USDT have 6 decimals)
# is at least this. 0 = settle everything, paying gas yourself if needed.
MIN_FEE_QUOTE=0

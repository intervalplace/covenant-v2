# AON node the interface reads from and publishes to, plus fallbacks
NEXT_PUBLIC_AON_NODE_URL=https://explorer.aon.network
NEXT_PUBLIC_AON_NODE_FALLBACKS=

# 1 = Ethereum mainnet, 31337 = local anvil/hardhat
NEXT_PUBLIC_CHAIN_ID=1
# Your RPC (recommended), plus optional comma-separated fallbacks.
# Public defaults are tried after these.
NEXT_PUBLIC_ETH_RPC_URL=
NEXT_PUBLIC_ETH_RPC_FALLBACKS=

# Deployed AonEvmSpotSettlement (aon-namespace-evm-spot/src/contracts/GenericEvmSpotSettlement.sol)
NEXT_PUBLIC_EVM_SPOT_SETTLEMENT=

# Executor fee paid by the buyer, in basis points of each fill (10 = 0.10%). 0 = free.
NEXT_PUBLIC_EXECUTOR_FEE_BPS=0
# Optional interface-only order size cap, in quote units (0 or empty = no cap).
NEXT_PUBLIC_MAX_ORDER_QUOTE=

# Simulated balances/approvals for UI testing (AON objects are still real)
NEXT_PUBLIC_DEMO_MODE=false

# Token overrides for local/test deployments (keep the same decimals).
# Mainnet addresses are built in.
# NEXT_PUBLIC_WETH_ADDRESS=
# NEXT_PUBLIC_LINK_ADDRESS=
# NEXT_PUBLIC_QNT_ADDRESS=
# NEXT_PUBLIC_USDT_ADDRESS=
# NEXT_PUBLIC_USDC_ADDRESS=

# Where link-preview images load from: the brand bundle's gateway URL
# (npm run release:brand prints it), e.g. https://<brand CID>.ipfs.dweb.link
NEXT_PUBLIC_SITE_URL=

# Listed markets (default: ETH-USDC). e.g. ETH-USDC,LINK-USDC
NEXT_PUBLIC_MARKETS=
# Minimum order size in quote units (default 25000000 = 25 USDC)
NEXT_PUBLIC_MIN_ORDER_QUOTE=

# Public source repo (footer links the build to its release list)
NEXT_PUBLIC_REPO_URL=

# CSD/USDC market (the /csd/ page). Leave empty to hide it.
# NEXT_PUBLIC_CSD_MM_URL=https://mm.covenant.market
# NEXT_PUBLIC_CSD_SETTLEMENT=0x...
# NEXT_PUBLIC_CSD_EXPLORER=

# Production release settings (committed). Set the contract address after deploying.
# Everything here is public (it's baked into the site). No API keys.
# `npm run release:ipfs` builds only from this file, so anyone can rebuild
# the same CID from the same commit.

NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_EVM_SPOT_SETTLEMENT=0x2b563632192BD8Ccace85aEF14a33607C3a0193D

NEXT_PUBLIC_AON_NODE_URL=https://explorer.aon.network
NEXT_PUBLIC_AON_NODE_FALLBACKS=https://node2.aon.network,https://node3.aon.network,https://node4.aon.network

# Leave empty: the site uses the visitor's wallet and public RPCs. A keyed RPC
# URL here would be public to everyone.
NEXT_PUBLIC_ETH_RPC_URL=
NEXT_PUBLIC_ETH_RPC_FALLBACKS=

# Executor fee, basis points of each fill, paid by the buyer (10 = 0.10%)
NEXT_PUBLIC_EXECUTOR_FEE_BPS=10
NEXT_PUBLIC_MARKETS=ETH-USDC
# 25 USDC
NEXT_PUBLIC_MIN_ORDER_QUOTE=25000000
NEXT_PUBLIC_MAX_ORDER_QUOTE=
NEXT_PUBLIC_DEMO_MODE=false

# Where link previews load their images from
NEXT_PUBLIC_SITE_URL=https://covenant.market
# Public source repo; the footer links each build to the release list there
NEXT_PUBLIC_REPO_URL=https://github.com/intervalplace/covenant-v2
